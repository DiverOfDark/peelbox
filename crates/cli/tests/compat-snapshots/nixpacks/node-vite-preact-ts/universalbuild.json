[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "vite-preact-ts-starter",
      "language": "JavaScript",
      "build_system": "npm",
      "framework": "Vite",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [
        "nodejs",
        "npm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "npm install",
        "npm run build"
      ],
      "cache": [
        ".npm"
      ],
      "build_image": "docker.io/library/node:lts"
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "npx",
        "vite",
        "preview",
        "--host",
        "0.0.0.0"
      ],
      "workdir": "/app",
      "ports": [
        4173
      ]
    }
  }
]