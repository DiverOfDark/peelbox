[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "PDM",
      "reasoning": "Detected from pdm.lock"
    },
    "build": {
      "packages": [
        "python",
        "pip",
        "build-base",
        "ca-certificates"
      ],
      "env": {
        "PDM_PYTHON": "/usr/bin/python3"
      },
      "commands": [
        "pip install pdm",
        "pdm install --prod --no-self && sed -i \"1s|/build/.venv|/app/.venv|\" .venv/bin/* 2>/dev/null; ln -sf /usr/bin/python3 .venv/bin/python3 2>/dev/null; ln -sf python3 .venv/bin/python 2>/dev/null; true"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/pdm/"
      ],
      "build_image": "docker.io/library/python:latest"
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "python",
        "/app/main.py"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ]
    }
  }
]