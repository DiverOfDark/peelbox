[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "PDM",
      "reasoning": "Detected from pdm.lock"
    },
    "build": {
      "packages": [
        "python-3.13",
        "py3.13-pip",
        "build-base",
        "ca-certificates"
      ],
      "env": {
        "PDM_PYTHON": "/usr/bin/python3"
      },
      "commands": [
        "pip install pdm",
        "pdm install --prod --no-self"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/pdm/"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.13",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "python",
        "/app/main.py"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ]
    }
  }
]
