[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "docs",
      "language": "JavaScript",
      "build_system": "pnpm",
      "framework": "Next.js",
      "reasoning": "Detected from package.json in apps/docs"
    },
    "build": {
      "packages": [
        "nodejs-22",
        "pnpm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "pnpm config set dangerously-allow-all-builds true",
        "pnpm install",
        "cd apps/docs && pnpm run build"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-22",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "pnpm",
        "start"
      ],
      "workdir": "/app/apps/docs",
      "ports": [
        3000
      ]
    }
  },
