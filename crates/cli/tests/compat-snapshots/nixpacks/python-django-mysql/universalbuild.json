[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "pip",
      "framework": "Django",
      "reasoning": "Detected from requirements.txt"
    },
    "build": {
      "packages": [
        "python-3.13",
        "py3.13-pip",
        "build-base",
        "ca-certificates",
        "mariadb-connector-c-dev",
        "python-3.13-dev"
      ],
      "env": {},
      "commands": [
        "pip install --user --no-cache-dir -r requirements.txt"
      ],
      "cache": [
        ".cache/pip"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.13",
        "libgcc",
        "libstdc++",
        "ca-certificates",
        "mariadb-connector-c"
      ],
      "env": {
        "DJANGO_SETTINGS_MODULE": "python_django.settings"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "python",
        "manage.py",
        "runserver",
        "0.0.0.0:8000"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ],
      "health": {
        "endpoint": "/health/"
      }
    }
  }
]