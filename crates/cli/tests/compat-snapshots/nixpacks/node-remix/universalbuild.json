[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "node-remix",
      "language": "JavaScript",
      "build_system": "npm",
      "framework": "Remix",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [
        "nodejs-20",
        "npm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "npm ci",
        "npm run build"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-20",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "npm",
        "start"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/healthcheck"
      }
    }
  }
]