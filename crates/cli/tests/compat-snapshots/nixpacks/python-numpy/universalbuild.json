[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "pip",
      "reasoning": "Detected from requirements.txt"
    },
    "build": {
      "packages": [],
      "env": {},
      "commands": [
        "pip install --user --no-cache-dir -r requirements.txt"
      ],
      "cache": [
        ".cache/pip"
      ],
      "build_image": "docker.io/library/python:latest"
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "PATH": "/root/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "PYTHONUSERBASE": "/root/.local"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        },
        {
          "from": "/root/.local/",
          "to": "/root/.local/"
        }
      ],
      "command": [
        "python",
        "/app/main.py"
      ],
      "workdir": "/app",
      "ports": []
    }
  }
]