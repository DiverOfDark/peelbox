[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "swift",
      "language": "Swift",
      "build_system": "Swift Package Manager",
      "reasoning": "Detected from Package.swift"
    },
    "build": {
      "packages": [],
      "env": {},
      "commands": [
        "swift build -c release"
      ],
      "cache": [
        ".build"
      ],
      "build_image": "docker.io/library/swift:5.10"
    },
    "runtime": {
      "packages": [
        "glibc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".build/release/",
          "to": "/app/"
        },
        {
          "from": "/usr/lib/swift/linux/",
          "to": "/usr/lib/swift/linux/"
        }
      ],
      "command": [
        "/app/swift"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]