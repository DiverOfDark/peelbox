[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "pip",
      "reasoning": "Detected from requirements.txt"
    },
    "build": {
      "packages": [
        "python-3.13",
        "py3.13-pip",
        "build-base",
        "ca-certificates",
        "postgresql-18-dev",
        "python-3.13-dev"
      ],
      "env": {},
      "commands": [
        "pip install --user --no-cache-dir -r requirements.txt"
      ],
      "cache": [
        ".cache/pip"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.13",
        "libgcc",
        "libstdc++",
        "ca-certificates",
        "libpq-18"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "python",
        "/app/main.py"
      ],
      "workdir": "/app",
      "ports": []
    }
  }
]