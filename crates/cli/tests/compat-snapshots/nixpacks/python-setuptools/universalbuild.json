[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "pip",
      "framework": "Flask",
      "reasoning": "Detected from pyproject.toml"
    },
    "build": {
      "packages": [
        "python",
        "pip",
        "build-base",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "pip install --user --no-cache-dir ."
      ],
      "cache": [
        ".cache/pip"
      ],
      "build_image": "docker.io/library/python:latest"
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "PATH": "/root/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "PORT": "",
        "PYTHONUSERBASE": "/root/.local"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        },
        {
          "from": "/root/.local/",
          "to": "/root/.local"
        }
      ],
      "command": [
        "python",
        "/app/nixpacks-setuptools/__main__.py"
      ],
      "workdir": "/app",
      "ports": [
        5000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]