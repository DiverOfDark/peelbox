[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "rocket",
      "language": "Rust",
      "build_system": "Cargo",
      "framework": "Rocket",
      "reasoning": "Detected from Cargo.toml"
    },
    "build": {
      "packages": [],
      "env": {
        "CARGO_HOME": "/usr/local/cargo",
        "PATH": "/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "RUSTUP_HOME": "/usr/local/rustup"
      },
      "commands": [
        "apt-get update && apt-get install -y --no-install-recommends build-essential libssl-dev pkg-config ca-certificates && rm -rf /var/lib/apt/lists/*",
        "cargo build --release"
      ],
      "cache": [
        "/usr/local/cargo",
        "target"
      ],
      "build_image": "docker.io/library/rust:latest"
    },
    "runtime": {
      "packages": [
        "glibc",
        "libssl3",
        "ca-certificates"
      ],
      "env": {
        "ROCKET_ADDRESS": "0.0.0.0"
      },
      "copy": [
        {
          "from": "target/release/rocket",
          "to": "/app/rocket"
        }
      ],
      "command": [
        "/app/rocket"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]