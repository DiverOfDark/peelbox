[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "gin",
      "language": "Go",
      "build_system": "go mod",
      "framework": "Gin",
      "reasoning": "Detected from go.mod"
    },
    "build": {
      "packages": [
        "build-base",
        "curl",
        "git",
        "ca-certificates"
      ],
      "env": {
        "CGO_ENABLED": "0",
        "GOCACHE": "/build/.cache/go-build",
        "GOMODCACHE": "/build/.cache/go-mod",
        "GOROOT": "/usr/local/go",
        "GOSUMDB": "off",
        "PATH": "/usr/local/go/bin:${PATH}"
      },
      "commands": [
        "curl -fsSL https://go.dev/dl/go1.18.linux-amd64.tar.gz | tar -C /usr/local -xzf -",
        "go mod download",
        "go build -o gin ."
      ],
      "cache": [
        ".cache/go-build",
        ".cache/go-mod"
      ]
    },
    "runtime": {
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "gin",
          "to": "/app/gin"
        }
      ],
      "command": [
        "/app/gin"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]