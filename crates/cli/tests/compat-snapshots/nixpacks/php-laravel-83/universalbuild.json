[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "PHP",
      "build_system": "Composer",
      "framework": "Laravel",
      "reasoning": "Detected from composer.json"
    },
    "build": {
      "packages": [
        "php-8.3",
        "composer",
        "unzip",
        "git",
        "ca-certificates",
        "php-8.3-ctype",
        "php-8.3-phar",
        "php-8.3-openssl",
        "php-8.3-mbstring",
        "php-8.3-xml",
        "php-8.3-dom",
        "php-8.3-curl"
      ],
      "env": {},
      "commands": [
        "composer install --no-dev --optimize-autoloader --ignore-platform-reqs",
        "[ -f .env ] || cp .env.example .env 2>/dev/null || echo 'APP_KEY=' > .env; php artisan key:generate --force 2>/dev/null || true"
      ],
      "cache": [
        ".composer/cache"
      ],
      "build_image": "docker.io/library/php:8.3-cli",
      "asset_build": {
        "build_image": "docker.io/library/node:lts",
        "commands": [
          "npm ci",
          "npm run build"
        ],
        "cache": [
          ".npm"
        ],
        "env": {}
      }
    },
    "runtime": {
      "packages": [
        "php-8.3",
        "php-8.3-ctype",
        "php-8.3-phar",
        "php-8.3-openssl",
        "php-8.3-mbstring",
        "php-8.3-xml",
        "php-8.3-dom",
        "php-8.3-curl",
        "php-8.3-fileinfo",
        "php-8.3-iconv",
        "php-8.3-pdo_sqlite",
        "busybox",
        "ca-certificates"
      ],
      "env": {
        "APP_ENV": "production",
        "CACHE_STORE": "file",
        "SESSION_DRIVER": "file"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "php",
        "artisan",
        "serve",
        "--host=0.0.0.0",
        "--port=8000"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]