[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "versiontest",
      "language": "Go",
      "build_system": "go mod",
      "reasoning": "Detected from go.mod"
    },
    "build": {
      "packages": [],
      "env": {
        "CGO_ENABLED": "0",
        "GOCACHE": "/app/.cache/go-build",
        "GOMODCACHE": "/app/.cache/go-mod",
        "GOSUMDB": "off"
      },
      "commands": [
        "go mod download",
        "mkdir -p bin",
        "go build -o bin/versiontest ."
      ],
      "cache": [
        ".cache/go-build",
        ".cache/go-mod"
      ],
      "build_image": "docker.io/library/golang:1.18"
    },
    "runtime": {
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "bin/versiontest",
          "to": "/app/versiontest"
        }
      ],
      "command": [
        "/app/versiontest"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]