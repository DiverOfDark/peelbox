[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "clojure-example",
      "language": "Clojure",
      "build_system": "Clojure CLI/tools.build",
      "reasoning": "Detected from deps.edn"
    },
    "build": {
      "packages": [],
      "env": {
        "JAVA_HOME": "/opt/java/openjdk",
        "PATH": "/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "curl -fsSL https://download.clojure.org/install/linux-install-1.11.1.1435.sh | bash -s -- -p /usr/local",
        "clojure -T:build uber"
      ],
      "cache": [
        ".m2",
        ".gitlibs",
        ".cpcache"
      ],
      "build_image": "docker.io/library/eclipse-temurin:17"
    },
    "runtime": {
      "packages": [
        "openjdk-17-jre",
        "ca-certificates"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "copy": [
        {
          "from": "target/*-standalone.jar",
          "to": "/app/clojure-example-standalone.jar"
        }
      ],
      "command": [
        "java",
        "-jar",
        "/app/clojure-example-standalone.jar"
      ],
      "workdir": "/app",
      "ports": []
    }
  }
]