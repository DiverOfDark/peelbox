[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "Pipenv",
      "reasoning": "Detected from Pipfile"
    },
    "build": {
      "packages": [],
      "env": {},
      "commands": [
        "pip install --user pipenv",
        "/root/.local/bin/pipenv lock --python $(which python3) && /root/.local/bin/pipenv requirements > /tmp/requirements.txt && pip install --user --no-cache-dir -r /tmp/requirements.txt"
      ],
      "cache": [
        "/root/.cache/pip/"
      ],
      "build_image": "docker.io/library/python:3.11"
    },
    "runtime": {
      "packages": [
        "python-3.11",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "PATH": "/root/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "PYTHONUSERBASE": "/root/.local"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        },
        {
          "from": "/root/.local/",
          "to": "/root/.local/"
        }
      ],
      "command": [
        "python",
        "/app/main.py"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ]
    }
  }
]