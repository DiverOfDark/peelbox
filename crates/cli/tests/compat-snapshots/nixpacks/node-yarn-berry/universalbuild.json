[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "fastify",
      "language": "JavaScript",
      "build_system": "Yarn",
      "reasoning": "Detected from yarn.lock"
    },
    "build": {
      "packages": [
        "nodejs-18",
        "yarn",
        "ca-certificates",
        "npm"
      ],
      "env": {
        "YARN_ENABLE_GLOBAL_CACHE": "false"
      },
      "commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "mkdir -p /usr/local/bin && printf '#!/bin/sh\\nnode /app/.yarn/releases/yarn-3.2.4.cjs  \"$@\"\\n' > /usr/local/bin/yarn && chmod +x /usr/local/bin/yarn",
        "yarn install",
        "yarn run build"
      ],
      "cache": [
        ".yarn-cache"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-18",
        "yarn",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "node",
        ".yarn/releases/yarn-3.2.4.cjs",
        "start"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]