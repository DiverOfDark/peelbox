[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "clojure-example",
      "language": "Clojure",
      "build_system": "Leiningen",
      "reasoning": "Detected from project.clj"
    },
    "build": {
      "packages": [],
      "env": {
        "JAVA_HOME": "/opt/java/openjdk",
        "LEIN_HOME": "/app/.lein",
        "PATH": "/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "mkdir -p /usr/local/bin && curl -fsSL https://raw.githubusercontent.com/technomancy/leiningen/stable/bin/lein -o /usr/local/bin/lein && chmod +x /usr/local/bin/lein && LEIN_HOME=/app/.lein lein version",
        "lein uberjar"
      ],
      "cache": [
        ".lein",
        ".m2"
      ],
      "build_image": "docker.io/library/eclipse-temurin:17"
    },
    "runtime": {
      "packages": [
        "openjdk-17-jre",
        "ca-certificates"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "copy": [
        {
          "from": "target/uberjar/clojure-example-0.1.0-SNAPSHOT-standalone.jar",
          "to": "/app/clojure-example-0.1.0-SNAPSHOT-standalone.jar"
        }
      ],
      "command": [
        "java",
        "-jar",
        "/app/clojure-example-0.1.0-SNAPSHOT-standalone.jar"
      ],
      "workdir": "/app",
      "ports": []
    }
  }
]