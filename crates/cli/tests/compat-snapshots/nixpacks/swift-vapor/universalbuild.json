[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "swift-vapor",
      "language": "Swift",
      "build_system": "Swift Package Manager",
      "reasoning": "Detected from Package.swift"
    },
    "build": {
      "packages": [
        "curl",
        "ca-certificates",
        "build-base",
        "binutils",
        "libstdc++-dev",
        "zlib-dev",
        "libxml2-dev",
        "ncurses-dev"
      ],
      "env": {
        "PATH": "/usr/local/swift/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "swift build -c release"
      ],
      "cache": [
        ".build"
      ],
      "setup_commands": [
        "SWIFT_URL=\"https://download.swift.org/swift-5.10-release/ubi9/swift-5.10-RELEASE/swift-5.10-RELEASE-linux.tar.gz\" && curl -fsSL \"$SWIFT_URL\" -o /tmp/swift.tar.gz && mkdir -p /usr/local/swift && tar -xzf /tmp/swift.tar.gz -C /usr/local/swift --strip-components=1 && rm /tmp/swift.tar.gz && swift --version"
      ]
    },
    "runtime": {
      "packages": [
        "glibc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".build/release/",
          "to": "/app/"
        },
        {
          "from": "/usr/local/swift/usr/lib/swift/linux/",
          "to": "/usr/lib/swift/linux/"
        }
      ],
      "command": [
        "/app/Run"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]