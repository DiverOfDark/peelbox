        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "chmod +x start.sh",
        "npm ci"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "busybox",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "./start.sh"
      ],
      "workdir": "/app",
      "ports": []
    }
  }
]
