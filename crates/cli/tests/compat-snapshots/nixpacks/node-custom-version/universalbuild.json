[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Shell",
      "build_system": "Shell",
      "reasoning": "Detected from start.sh"
    },
    "build": {
      "packages": [
        "ca-certificates",
        "nodejs-22",
        "npm"
      ],
      "env": {},
