[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Java",
      "build_system": "Gradle",
      "reasoning": "Detected from build.gradle"
    },
    "build": {
      "packages": [
        "openjdk-18",
        "bash",
        "ca-certificates"
      ],
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.native=false",
        "GRADLE_USER_HOME": "/root/.gradle",
        "JAVA_HOME": "/opt/java/openjdk",
        "PATH": "/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "./gradlew assemble -x test --no-daemon --console=plain"
      ],
      "cache": [
        ".gradle",
        "build"
      ],
      "build_image": "docker.io/library/gradle:7-jdk18"
    },
    "runtime": {
      "packages": [
        "openjdk-18-jre",
        "ca-certificates"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-18-openjdk",
        "PATH": "/usr/lib/jvm/java-18-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "copy": [
        {
          "from": "build/libs/*.jar",
          "to": "/app/app.jar"
        }
      ],
      "command": [
        "java",
        "-jar",
        "/app/app.jar"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]
