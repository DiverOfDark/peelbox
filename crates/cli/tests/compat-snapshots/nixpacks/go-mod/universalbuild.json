[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "gin",
      "language": "Go",
      "build_system": "go mod",
      "framework": "Gin",
      "reasoning": "Detected from go.mod"
    },
    "build": {
      "packages": [],
      "env": {
        "CGO_ENABLED": "0",
        "GOCACHE": "/app/.cache/go-build",
        "GOMODCACHE": "/app/.cache/go-mod",
        "GOSUMDB": "off"
      },
      "commands": [
        "go mod download",
        "mkdir -p bin",
        "go build -o bin/gin ."
      ],
      "cache": [
        ".cache/go-build",
        ".cache/go-mod"
      ],
      "build_image": "docker.io/library/golang:1.17"
    },
    "runtime": {
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "bin/gin",
          "to": "/app/gin"
        }
      ],
      "command": [
        "/app/gin"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]