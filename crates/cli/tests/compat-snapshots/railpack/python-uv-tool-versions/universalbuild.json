[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "uv",
      "reasoning": "Detected from uv.lock"
    },
    "build": {
      "packages": [],
      "env": {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "UV_CACHE_DIR": "/root/.cache/uv"
      },
      "commands": [
        "pip install --user uv",
        "/root/.local/bin/uv sync --frozen --no-dev"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/uv/"
      ],
      "build_image": "docker.io/library/python:latest"
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "python",
        "/app/main.py"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ]
    }
  }
]