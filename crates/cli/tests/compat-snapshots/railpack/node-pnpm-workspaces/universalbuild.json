[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "node-pnpm-workspaces",
      "language": "JavaScript",
      "build_system": "pnpm",
      "reasoning": "Detected from pnpm-lock.yaml"
    },
    "build": {
      "packages": [],
      "env": {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "pnpm install"
      ],
      "cache": [
        ".pnpm-store"
      ],
      "build_image": "docker.io/library/node:22"
    },
    "runtime": {
      "packages": [
        "nodejs-22",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "node",
        "index.js"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]