[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "tanstack-start-example-basic",
      "language": "JavaScript",
      "build_system": "Bun",
      "framework": "Vite",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "bun",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "bun install",
        "bun run build"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "bun",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "node",
        ".output/server/index.mjs"
      ],
      "workdir": "/app",
      "ports": [
        3000,
        4173
      ]
    }
  }
]