[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "cpp-meson",
      "language": "C++",
      "build_system": "Meson",
      "reasoning": "Detected from meson.build"
    },
    "build": {
      "packages": [
        "meson",
        "build-base",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "meson setup build --buildtype=release --wipe 2>/dev/null || meson setup build --buildtype=release",
        "meson compile -C build"
      ],
      "cache": [
        "build/"
      ]
    },
    "runtime": {
      "packages": [
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "build/cpp-meson",
          "to": "/app/cpp-meson"
        }
      ],
      "command": [
        "/app/cpp-meson"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]