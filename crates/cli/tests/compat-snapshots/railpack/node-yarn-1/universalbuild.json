[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "node-yarn-1",
      "language": "JavaScript",
      "build_system": "Yarn",
      "reasoning": "Detected from yarn.lock"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "yarn",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "yarn install --network-timeout 100000 --network-concurrency 1",
        "yarn run build"
      ],
      "cache": [
        ".yarn-cache"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "yarn",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "yarn",
        "start"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]