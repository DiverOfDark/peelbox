[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "java-zulu-version",
      "language": "Java",
      "build_system": "Maven",
      "reasoning": "Detected from pom.xml"
    },
    "build": {
      "packages": [
        "openjdk-8",
        "maven",
        "ca-certificates"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-1.8-openjdk",
        "MAVEN_OPTS": "-Dmaven.repo.local=/root/.m2/repository"
      },
      "commands": [
        "mvn package -DskipTests",
        "mvn dependency:copy-dependencies -DoutputDirectory=target/lib"
      ],
      "cache": [
        "/root/.m2/repository"
      ],
      "build_image": "docker.io/library/maven:3-eclipse-temurin-8"
    },
    "runtime": {
      "packages": [
        "openjdk-8-jre",
        "ca-certificates"
      ],
      "env": {
        "CLASSPATH": "/app/*:/app/lib/*",
        "JAVA_HOME": "/usr/lib/jvm/java-1.8-openjdk",
        "PATH": "/usr/lib/jvm/java-1.8-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "copy": [
        {
          "from": "target/*.jar",
          "to": "/app/"
        },
        {
          "from": "target/lib/",
          "to": "/app/lib"
        }
      ],
      "command": [
        "java",
        "-cp",
        "/app/*:/app/lib/*",
        "com.railpack.App"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]