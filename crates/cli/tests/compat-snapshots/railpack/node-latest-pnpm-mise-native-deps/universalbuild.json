[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "node-latest-pnpm-mise-native-deps",
      "language": "JavaScript",
      "build_system": "pnpm",
      "reasoning": "Detected from pnpm-lock.yaml"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "build-base",
        "python-3.12",
        "npm",
        "ca-certificates",
        "sqlite-dev"
      ],
      "env": {},
      "commands": [
        "pnpm install"
      ],
      "cache": [
        ".pnpm-store"
      ],
      "setup_commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "mkdir -p /usr/lib/node_modules/pnpm/dist/node_modules && ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/pnpm/dist/node_modules/node-gyp"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates",
        "sqlite-libs"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "node",
        "index.js"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]