[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "node-yarn-3",
      "language": "JavaScript",
      "build_system": "Yarn",
      "reasoning": "Detected from yarn.lock"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "yarn",
        "ca-certificates",
        "corepack"
      ],
      "env": {},
      "commands": [
        "corepack enable",
        "yarn install",
        "./node_modules/.bin/tsc"
      ],
      "cache": [
        ".yarn-cache"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "node",
        "index.js"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]