[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "@monorepo/api",
      "language": "JavaScript",
      "build_system": "npm",
      "framework": "Express",
      "reasoning": "Detected from package.json in packages/api"
    },
    "build": {
      "packages": [],
      "env": {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "npm install"
      ],
      "cache": [
        ".npm"
      ],
      "build_image": "docker.io/library/node:lts"
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {
        "PORT": ""
      },
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "node",
        "index.js"
      ],
      "workdir": "/app/packages/api",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]