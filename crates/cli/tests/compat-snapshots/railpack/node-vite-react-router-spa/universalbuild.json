[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "note-vite-react-router-spa",
      "language": "JavaScript",
      "build_system": "pnpm",
      "framework": "React Router",
      "reasoning": "Detected from pnpm-lock.yaml"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "build-base",
        "python-3.12",
        "npm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "pnpm install",
        "pnpm build"
      ],
      "cache": [
        ".pnpm-store"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "pnpm",
        "exec",
        "react-router-serve",
        "build/server/index.js"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]