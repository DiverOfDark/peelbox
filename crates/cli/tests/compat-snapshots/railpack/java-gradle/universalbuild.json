[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Java",
      "build_system": "Gradle",
      "reasoning": "Detected from build.gradle.kts in app"
    },
    "build": {
      "packages": [
        "openjdk-21",
        "gradle-8",
        "ca-certificates"
      ],
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.native=false",
        "GRADLE_USER_HOME": "/root/.gradle",
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk"
      },
      "commands": [
        "gradle :app:installDist -x test --no-daemon --console=plain"
      ],
      "cache": [
        ".gradle",
        "build"
      ],
      "build_image": "docker.io/library/gradle:latest-jdk21"
    },
    "runtime": {
      "packages": [
        "openjdk-21-jre",
        "ca-certificates",
        "busybox"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk",
        "PATH": "/usr/lib/jvm/java-21-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "copy": [
        {
          "from": "app/build/install/app/.",
          "to": "/app"
        }
      ],
      "command": [
        "/app/bin/app"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]