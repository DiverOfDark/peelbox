      "language": "Python",
      "build_system": "pip",
      "reasoning": "Detected from requirements.txt"
    },
    "build": {
      "packages": [
        "python-3.11",
        "py3.11-pip",
        "build-base",
        "ca-certificates",
        "cairo-dev",
        "poppler-utils",
        "ffmpeg"
      ],
      "env": {},
