        "pip install --user --no-cache-dir -r requirements.txt"
      ],
      "cache": [
        ".cache/pip"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.11",
        "libgcc",
        "libstdc++",
        "ca-certificates",
        "libpq-18",
        "cairo",
        "poppler-utils",
        "ffmpeg"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "python",
        "/app/main.py"
      ],
      "workdir": "/app",
      "ports": []
    }
  }
]