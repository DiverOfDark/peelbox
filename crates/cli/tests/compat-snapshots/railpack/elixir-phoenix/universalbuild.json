[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "hello",
      "language": "Elixir",
      "build_system": "Mix",
      "framework": "Phoenix",
      "reasoning": "Detected from mix.exs"
    },
    "build": {
      "packages": [],
      "env": {
        "DATABASE_URL": "",
        "ELIXIR_ERL_OPTIONS": "+fnu",
        "LC_ALL": "C.UTF-8",
        "MIX_ENV": "prod",
        "MIX_HOME": "/app/.mix",
        "POOL_SIZE": "",
        "SECRET_KEY_BASE": ""
      },
      "commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "mix local.hex --force && mix local.rebar --force",
        "rm -f mix.lock && mix deps.get",
        "mix deps.compile || { sed -i 's/\"~> [0-9][^\"]*\"/\">= 0.0.0\"/g' mix.exs && find deps _build -mindepth 1 -delete 2>/dev/null; rm -f mix.lock && mix deps.get && mix deps.compile; }",
        "mix assets.deploy",
        "mix compile"
      ],
      "cache": [
        "deps",
        "_build"
      ],
      "build_image": "docker.io/library/elixir:1.14"
    },
    "runtime": {
      "packages": [
        "elixir-1.17",
        "erlang-26",
        "busybox",
        "git",
        "openssl",
        "ca-certificates"
      ],
      "env": {
        "DNS_CLUSTER_QUERY": "",
        "ELIXIR_ERL_OPTIONS": "+fnu",
        "LC_ALL": "C.UTF-8",
        "MAILGUN_API_KEY": "",
        "MAILGUN_DOMAIN": "",
        "MIX_ENV": "prod",
        "MIX_HOME": "/app/.mix",
        "PHX_HOST": "example.com",
        "PHX_SERVER": "",
        "PORT": "4000",
        "SECRET_KEY_BASE": "please-change-me-in-production-this-is-a-placeholder-key-that-is-at-least-64-bytes-long",
        "SOME_APP_SSL_CERT_PATH": "",
        "SOME_APP_SSL_KEY_PATH": ""
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "mix",
        "run",
        "--no-halt"
      ],
      "workdir": "/app",
      "ports": [
        4000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]