[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app_gleam",
      "language": "Gleam",
      "build_system": "Gleam",
      "reasoning": "Detected from gleam.toml"
    },
    "build": {
      "packages": [],
      "env": {},
      "commands": [
        "gleam export erlang-shipment"
      ],
      "cache": [
        "build"
      ],
      "build_image": "ghcr.io/gleam-lang/gleam:v1.13.0-erlang"
    },
    "runtime": {
      "packages": [
        "erlang-26",
        "busybox",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "build/erlang-shipment",
          "to": "/app/build/erlang-shipment"
        }
      ],
      "command": [
        "./build/erlang-shipment/entrypoint.sh",
        "run"
      ],
      "workdir": "/app",
      "ports": [
        4000
      ]
    }
  }
]