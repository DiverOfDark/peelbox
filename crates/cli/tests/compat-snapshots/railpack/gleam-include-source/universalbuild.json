[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app_gleam",
      "language": "Gleam",
      "build_system": "Gleam",
      "reasoning": "Detected from gleam.toml"
    },
    "build": {
      "packages": [
        "erlang-27",
        "rebar3",
        "curl",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "curl -fsSL https://github.com/gleam-lang/gleam/releases/latest/download/gleam-$(uname -m)-unknown-linux-musl.tar.gz | tar -xzC /usr/local/bin/",
        "gleam export erlang-shipment"
      ],
      "cache": [
        "build"
      ]
    },
    "runtime": {
      "packages": [
        "erlang-27",
        "ca-certificates"
      ],
      "env": {},
      "copy": [],
      "command": [
        "./build/erlang-shipment/entrypoint.sh",
        "run"
      ],
      "workdir": "/app",
      "ports": [
        4000
      ]
    }
  }
]