[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "railpack",
      "language": "Go",
      "build_system": "go mod",
      "reasoning": "Detected from go.mod"
    },
    "build": {
      "packages": [
        "go-1.23",
        "git",
        "ca-certificates"
      ],
      "env": {
        "CGO_ENABLED": "0",
        "GOCACHE": "/app/.cache/go-build",
        "GOMODCACHE": "/app/.cache/go-mod",
        "GOSUMDB": "off"
      },
      "commands": [
        "go mod download",
        "mkdir -p bin",
        "go build -o bin/railpack ."
      ],
      "cache": [
        ".cache/go-build",
        ".cache/go-mod"
      ]
    },
    "runtime": {
      "packages": [
        "glibc",
        "ca-certificates",
        "go-1.25"
      ],
      "env": {},
      "copy": [
        {
          "from": "bin/railpack",
          "to": "/app/railpack"
        }
      ],
      "command": [
        "/app/railpack"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]