[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "my-app",
      "language": "JavaScript",
      "build_system": "pnpm",
      "framework": "SvelteKit",
      "reasoning": "Detected from pnpm-lock.yaml"
    },
    "build": {
      "packages": [
        "nodejs",
        "pnpm",
        "build-base",
        "python",
        "npm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "pnpm install",
        "pnpm build"
      ],
      "cache": [
        ".pnpm-store"
      ],
      "build_image": "docker.io/library/node:lts"
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "node",
        "build/index.js"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]