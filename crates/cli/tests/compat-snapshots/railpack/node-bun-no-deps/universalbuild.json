[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "name-of-project",
      "language": "JavaScript",
      "build_system": "Bun",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "bun",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "bun install"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "bun",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "bun",
        "start"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ]
    }
  }
]