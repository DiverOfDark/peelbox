[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "uv",
      "framework": "FastAPI",
      "reasoning": "Detected from uv.lock"
    },
    "build": {
      "packages": [
        "python-3.12",
        "py3.12-pip",
        "build-base",
        "ca-certificates"
      ],
      "env": {
        "UV_CACHE_DIR": "/root/.cache/uv"
      },
      "commands": [
        "pip install --user uv",
        "/root/.local/bin/uv sync --frozen --no-dev"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/uv/"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "PATH": "/build/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/build/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/build"
        }
      ],
      "command": [
        "uvicorn",
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "workdir": "/build",
      "ports": [
        8000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]