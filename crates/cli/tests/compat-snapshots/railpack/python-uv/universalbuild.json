[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "uv",
      "framework": "Flask",
      "reasoning": "Detected from uv.lock"
    },
    "build": {
      "packages": [
        "python-3.11",
        "py3.11-pip",
        "build-base",
        "ca-certificates"
      ],
      "env": {
        "UV_CACHE_DIR": "/root/.cache/uv"
      },
      "commands": [
        "pip install --user uv",
        "/root/.local/bin/uv sync --frozen --no-dev"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/uv/"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.11",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "FLASK_APP": "/app/main.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "flask",
        "run"
      ],
      "workdir": "/app",
      "ports": [
        5000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]