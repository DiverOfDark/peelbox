[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "uv",
      "framework": "Django",
      "reasoning": "Detected from uv.lock"
    },
    "build": {
      "packages": [],
      "env": {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "UV_CACHE_DIR": "/root/.cache/uv"
      },
      "commands": [
        "pip install --user uv",
        "/root/.local/bin/uv sync --frozen --no-dev"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/uv/"
      ],
      "build_image": "docker.io/library/python:3.11"
    },
    "runtime": {
      "packages": [
        "python-3.11",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "DATABASE_URL": "",
        "DJANGO_SETTINGS_MODULE": "mysite.settings",
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "REDIS_URL": "",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "python",
        "manage.py",
        "runserver",
        "0.0.0.0:8000"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ],
      "health": {
        "endpoint": "/health/"
      }
    }
  }
]