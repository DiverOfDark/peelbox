[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "db-package",
      "language": "Python",
      "build_system": "uv",
      "reasoning": "Detected from pyproject.toml in db-package"
    },
    "build": {
      "packages": [
        "python-3.12",
        "py3.12-pip",
        "build-base",
        "ca-certificates",
        "postgresql-18-dev",
        "python-3.12-dev"
      ],
      "env": {
        "UV_CACHE_DIR": "/root/.cache/uv"
      },
      "commands": [
        "pip install --user uv",
        "/root/.local/bin/uv sync --frozen --no-dev --package db-package"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/uv/"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates",
        "uv",
        "libpq-18"
      ],
      "env": {
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "PYTHONUSERBASE": "/root/.local",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "python",
        "-m",
        "db_package"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ]
    }
  }
]