[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "PHP",
      "build_system": "Composer",
      "reasoning": "Detected from composer.json"
    },
    "build": {
      "packages": [],
      "env": {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "composer install --no-dev --optimize-autoloader --ignore-platform-reqs",
        "[ -f .env ] || cp .env.example .env 2>/dev/null || echo 'APP_KEY=' > .env; php artisan key:generate --force 2>/dev/null || true"
      ],
      "cache": [
        ".composer/cache"
      ],
      "build_image": "docker.io/library/php:8.1-cli"
    },
    "runtime": {
      "packages": [
        "php-8.1",
        "php-8.1-ctype",
        "php-8.1-phar",
        "php-8.1-openssl",
        "php-8.1-mbstring",
        "php-8.1-xml",
        "php-8.1-dom",
        "php-8.1-curl",
        "php-8.1-fileinfo",
        "php-8.1-iconv",
        "php-8.1-pdo_sqlite",
        "busybox",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "php",
        "-S",
        "0.0.0.0:8000",
        "index.php"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
