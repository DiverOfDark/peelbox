[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "PDM",
      "framework": "Flask",
      "reasoning": "Detected from pyproject.toml"
    },
    "build": {
      "packages": [],
      "env": {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PDM_PYTHON": "/usr/bin/python3"
      },
      "commands": [
        "pip install pdm",
        "pdm export --no-hashes --prod -o requirements.txt",
        "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && sed -i \"1s|/build/.venv|/app/.venv|\" .venv/bin/* 2>/dev/null; ln -sf /usr/bin/python3 .venv/bin/python3 && ln -sf python3 .venv/bin/python"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/pdm/"
      ],
      "build_image": "docker.io/library/python:latest"
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "FLASK_APP": "/app/app.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "flask",
        "run"
      ],
      "workdir": "/app",
      "ports": [
        5000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]
