[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "puppeteer-app",
      "language": "JavaScript",
      "build_system": "npm",
      "framework": "Express",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [],
      "env": {
        "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true"
      },
      "commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "npm ci"
      ],
      "cache": [
        ".npm"
      ],
      "build_image": "docker.io/library/node:22"
    },
    "runtime": {
      "packages": [
        "nodejs-22",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates",
        "chromium",
        "nss",
        "freetype",
        "harfbuzz",
        "font-freefont",
        "font-liberation"
      ],
      "env": {
        "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium-browser"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "node",
        "src/screenshot.js"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
