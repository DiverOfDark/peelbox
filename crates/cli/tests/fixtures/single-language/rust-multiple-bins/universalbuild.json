[
    {
        "build": {
            "cache": [
                ".cargo",
                "target"
            ],
            "commands": [
                "cargo build --release"
            ],
            "env": {
                "CARGO_HOME": ".cargo"
            },
            "packages": [
                "rust-1.92",
                "build-base",
                "openssl-dev",
                "pkgconf",
                "ca-certificates"
            ]
        },
        "metadata": {
            "build_system": "Cargo",
            "language": "Rust",
            "project_name": "multi-bin-app",
            "reasoning": "Detected from Cargo.toml"
        },
        "runtime": {
            "command": [
                "/app/multi-bin-app"
            ],
            "copy": [
                {
                    "from": "target/release/multi-bin-app",
                    "to": "/app/multi-bin-app"
                }
            ],
            "env": {},
            "packages": [
                "glibc",
                "libssl3",
                "ca-certificates"
            ],
            "ports": [
                8080
            ],
            "workdir": "/app"
        },
        "version": "1.0"
    }
]
