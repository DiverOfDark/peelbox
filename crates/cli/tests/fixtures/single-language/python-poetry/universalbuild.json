[
  {
    "build": {
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/pypoetry/"
      ],
      "commands": [
        "pip install poetry poetry-plugin-export",
        "poetry lock --no-update 2>/dev/null || poetry lock",
        "poetry export --without-hashes -f requirements.txt -o requirements.txt --only main",
        "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && find .venv/bin -type f -exec sed -i \"s|#\\!/build/.venv/|#\\!/app/.venv/|g\" {} + && ln -sf /usr/bin/python3 .venv/bin/python3 && ln -sf python3 .venv/bin/python"
      ],
      "env": {
        "POETRY_CACHE_DIR": "/root/.cache/pypoetry",
        "POETRY_VIRTUALENVS_IN_PROJECT": "true"
      },
      "packages": [
        "python-3.12",
        "py3.12-pip",
        "build-base",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Poetry",
      "framework": "Flask",
      "language": "Python",
      "project_name": "app",
      "reasoning": "Detected from pyproject.toml"
    },
    "runtime": {
      "command": [
        "flask",
        "run"
      ],
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "env": {
        "FLASK_APP": "/app/app.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "health": {
        "endpoint": "/"
      },
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "ports": [
        5000
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
