{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "react-router.config.ts", "vite.config.ts"]
}
