[
  {
    "build": {
      "cache": [
        ".composer/cache"
      ],
      "commands": [
        "composer config allow-plugins.symfony/runtime true",
        "composer install --no-dev --optimize-autoloader --ignore-platform-reqs"
      ],
      "env": {},
      "packages": [
        "php-8.1",
        "composer",
        "unzip",
        "git",
        "ca-certificates",
        "php-8.1-ctype",
        "php-8.1-phar",
        "php-8.1-openssl",
        "php-8.1-mbstring",
        "php-8.1-xml",
        "php-8.1-dom",
        "php-8.1-curl"
      ]
    },
    "metadata": {
      "build_system": "Composer",
      "framework": "Symfony",
      "language": "PHP",
      "project_name": "app",
      "reasoning": "Detected from composer.json"
    },
    "runtime": {
      "command": [
        "/usr/bin/php",
        "-S",
        "0.0.0.0:8000",
        "-t",
        "/app/public"
      ],
      "copy": [
        {
          "from": "vendor/",
          "to": "/app/vendor"
        },
        {
          "from": "bin/",
          "to": "/app/bin"
        },
        {
          "from": "public/",
          "to": "/app/public"
        },
        {
          "from": "src/",
          "to": "/app/src"
        },
        {
          "from": "config/",
          "to": "/app/config"
        }
      ],
      "env": {},
      "health": {
        "endpoint": "/_health"
      },
      "packages": [
        "php-8.1",
        "php-8.1-ctype",
        "php-8.1-phar",
        "php-8.1-openssl",
        "php-8.1-mbstring",
        "php-8.1-xml",
        "php-8.1-dom",
        "php-8.1-curl",
        "php-8.1-fileinfo",
        "php-8.1-iconv",
        "php-8.1-intl",
        "php-8.1-pdo",
        "ca-certificates"
      ],
      "ports": [
        8000
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
