[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "PHP",
      "build_system": "Composer",
      "framework": "Symfony",
      "reasoning": "Detected from composer.json"
    },
    "build": {
      "packages": [],
      "env": {},
      "commands": [
        "composer config allow-plugins.symfony/runtime true",
        "composer install --no-dev --optimize-autoloader --ignore-platform-reqs",
        "[ -f .env ] || cp .env.example .env 2>/dev/null || echo 'APP_KEY=' > .env; php artisan key:generate --force 2>/dev/null || true"
      ],
      "cache": [
        ".composer/cache"
      ],
      "build_image": "docker.io/library/php:8.1-cli"
    },
    "runtime": {
      "packages": [
        "php-8.1",
        "php-8.1-ctype",
        "php-8.1-phar",
        "php-8.1-openssl",
        "php-8.1-mbstring",
        "php-8.1-xml",
        "php-8.1-dom",
        "php-8.1-curl",
        "php-8.1-fileinfo",
        "php-8.1-iconv",
        "php-8.1-pdo_sqlite",
        "php-8.1-intl",
        "php-8.1-pdo",
        "busybox",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "vendor/",
          "to": "/app/vendor"
        },
        {
          "from": "bin/",
          "to": "/app/bin"
        },
        {
          "from": "public/",
          "to": "/app/public"
        },
        {
          "from": "src/",
          "to": "/app/src"
        },
        {
          "from": "config/",
          "to": "/app/config"
        }
      ],
      "command": [
        "/usr/bin/php",
        "-S",
        "0.0.0.0:8000",
        "-t",
        "/app/public"
      ],
      "workdir": "/app",
      "ports": [
        8000
      ],
      "health": {
        "endpoint": "/_health"
      }
    }
  }
]
