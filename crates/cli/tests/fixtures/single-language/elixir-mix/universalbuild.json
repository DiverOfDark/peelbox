[
  {
    "metadata": {
      "project_name": "elixir_api",
      "language": "Elixir",
      "build_system": "Mix",
      "reasoning": "Detected from mix.exs"
    },
    "build": {
      "packages": ["elixir-1.18", "erlang-28", "erlang-28-dev", "git", "build-base", "openssl", "ca-certificates"],
      "commands": [
        "mix local.hex --force && mix local.rebar --force",
        "mix deps.get",
        "mix compile"
      ],
      "env": {
        "ELIXIR_ERL_OPTIONS": "+fnu",
        "LC_ALL": "C.UTF-8",
        "MIX_ENV": "prod",
        "MIX_HOME": "/build/.mix"
      },
      "cache": ["deps"]
    },
    "runtime": {
      "packages": ["elixir-1.18", "erlang-28", "busybox", "openssl", "ca-certificates"],
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": ["mix", "run", "--no-halt"],
      "ports": [4000],
      "env": {
        "ELIXIR_ERL_OPTIONS": "+fnu",
        "LC_ALL": "C.UTF-8",
        "MIX_ENV": "prod",
        "MIX_HOME": "/app/.mix",
        "PORT": "4000"
      },
      "workdir": "/app",
      "health": {
        "endpoint": "/health"
      }
    },
    "version": "1.0"
  }
]
