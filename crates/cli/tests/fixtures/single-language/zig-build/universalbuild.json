[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Zig",
      "build_system": "Zig Build",
      "framework": "Zap",
      "reasoning": "Detected from build.zig.zon"
    },
    "build": {
      "packages": [
        "zig",
        "build-base",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "zig build -Doptimize=ReleaseSafe"
      ],
      "cache": [
        "zig-cache"
      ]
    },
    "runtime": {
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "zig-out/bin/app",
          "to": "/app/app"
        },
        {
          "from": "zig-out/lib/",
          "to": "/app/lib/"
        }
      ],
      "command": [
        "/app/app"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
