[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "node-angular-ssr-app",
      "language": "TypeScript",
      "build_system": "npm",
      "framework": "Angular SSR",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [],
      "env": {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "npm ci",
        "npm run build"
      ],
      "cache": [
        ".npm"
      ],
      "build_image": "docker.io/library/node:lts"
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "node",
        "dist/node-angular-ssr-app/server/server.mjs"
      ],
      "workdir": "/app",
      "ports": [
        4000
      ]
    }
  }
]
