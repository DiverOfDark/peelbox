[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "node-angular-ssr-app",
      "language": "TypeScript",
      "build_system": "npm",
      "framework": "Angular SSR",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "npm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "npm ci",
        "npm run build"
      ],
      "cache": [
        ".npm"
      ],
      "setup_commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "node",
        "dist/node-angular-ssr-app/server/server.mjs"
      ],
      "workdir": "/app",
      "ports": [
        4000
      ]
    }
  }
]
