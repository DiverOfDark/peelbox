[
  {
    "build": {
      "cache": [
        ".stack",
        ".stack-work"
      ],
      "commands": [
        "curl -sSL https://get-ghcup.haskell.org | BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_INSTALL_STACK=1 BOOTSTRAP_HASKELL_INSTALL_HLS=0 bash",
        "export PATH=\"$HOME/.ghcup/bin:$PATH\"",
        "stack build --system-ghc --allow-different-user --copy-bins --local-bin-path .stack-bin"
      ],
      "env": {},
      "packages": [
        "build-base",
        "gcc",
        "gmp-dev",
        "zlib-dev",
        "ca-certificates",
        "curl",
        "bash"
      ]
    },
    "metadata": {
      "build_system": "Stack",
      "language": "Haskell",
      "project_name": "my-haskell-app",
      "reasoning": "Detected from stack.yaml"
    },
    "runtime": {
      "command": [
        "/app/my-haskell-app"
      ],
      "copy": [
        {
          "from": ".stack-bin/my-haskell-app",
          "to": "/app/my-haskell-app"
        }
      ],
      "env": {},
      "packages": [
        "glibc",
        "gmp",
        "zlib",
        "ca-certificates"
      ],
      "ports": [],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
