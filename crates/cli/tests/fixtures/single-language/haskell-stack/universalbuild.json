[
  {
    "build": {
      "cache": [
        ".stack",
        ".stack-work"
      ],
      "commands": [
        "curl -sSL https://downloads.haskell.org/~ghcup/x86_64-linux-ghcup -o /usr/local/bin/ghcup && chmod +x /usr/local/bin/ghcup",
        "ghcup install ghc --set && ghcup install stack --set",
        "stack build --system-ghc --allow-different-user --copy-bins --local-bin-path .stack-bin"
      ],
      "env": {
        "PATH": "/root/.ghcup/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "packages": [
        "build-base",
        "gcc",
        "glibc-dev",
        "gmp-dev",
        "zlib-dev",
        "ncurses-dev",
        "libffi-dev",
        "posix-libc-utils",
        "xz",
        "ca-certificates",
        "curl",
        "bash"
      ]
    },
    "metadata": {
      "build_system": "Stack",
      "language": "Haskell",
      "project_name": "my-haskell-app",
      "reasoning": "Detected from stack.yaml"
    },
    "runtime": {
      "command": [
        "/app/my-haskell-app"
      ],
      "copy": [
        {
          "from": ".stack-bin/my-haskell-app",
          "to": "/app/my-haskell-app"
        }
      ],
      "env": {},
      "packages": [
        "glibc",
        "gmp",
        "zlib",
        "ca-certificates"
      ],
      "ports": [],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
