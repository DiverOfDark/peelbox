[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "corepack-express-app",
      "language": "JavaScript",
      "build_system": "pnpm",
      "framework": "Express",
      "reasoning": "Detected from package.json"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "pnpm install"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "node",
        "src/index.js"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
