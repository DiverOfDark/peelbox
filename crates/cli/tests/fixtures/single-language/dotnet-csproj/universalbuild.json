[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "C#",
      "build_system": ".NET",
      "framework": "ASP.NET Core",
      "reasoning": "Detected from App.csproj"
    },
    "build": {
      "packages": [],
      "env": {
        "DOTNET_CLI_HOME": "/root",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "DOTNET_NOLOGO": "1",
        "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "rm -f global.json",
        "dotnet restore",
        "dotnet publish -c Release -o out"
      ],
      "cache": [
        ".nuget/packages",
        "bin",
        "obj"
      ],
      "build_image": "mcr.microsoft.com/dotnet/sdk:8.0"
    },
    "runtime": {
      "packages": [
        "aspnet-8-runtime",
        "ca-certificates"
      ],
      "env": {
        "ASPNETCORE_URLS": "http://0.0.0.0:5000"
      },
      "copy": [
        {
          "from": "out/",
          "to": "/app"
        }
      ],
      "command": [
        "dotnet",
        "/app/App.dll"
      ],
      "workdir": "/app",
      "ports": [
        5000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
