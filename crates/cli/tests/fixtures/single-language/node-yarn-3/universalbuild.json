[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "example-yarn3-app",
      "language": "JavaScript",
      "build_system": "Yarn",
      "reasoning": "Detected from yarn.lock"
    },
    "build": {
      "packages": [
        "nodejs",
        "yarn",
        "ca-certificates",
        "corepack"
      ],
      "env": {
        "YARN_ENABLE_GLOBAL_CACHE": "false"
      },
      "commands": [
        "corepack enable",
        "yarn install"
      ],
      "cache": [
        ".yarn-cache"
      ],
      "build_image": "docker.io/library/node:lts"
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "yarn",
        "busybox",
        "dumb-init",
        "ca-certificates",
        "corepack"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "command": [
        "sh",
        "-c",
        "corepack enable && exec yarn start"
      ],
      "workdir": "/app",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
