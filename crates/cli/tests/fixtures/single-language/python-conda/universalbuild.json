[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "Conda",
      "framework": "Flask",
      "reasoning": "Detected from environment.yml"
    },
    "build": {
      "packages": [],
      "env": {},
      "commands": [
        "pip install --user --no-cache-dir numpy==1.24 flask==3.0 gunicorn==21.2.0"
      ],
      "cache": [
        "/root/.cache/pip/"
      ],
      "build_image": "docker.io/library/python:3.11"
    },
    "runtime": {
      "packages": [
        "python-3.11",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "FLASK_APP": "/app/app.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/root/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "PYTHONUSERBASE": "/root/.local"
      },
      "copy": [
        {
          "from": ".",
          "to": "/app"
        },
        {
          "from": "/root/.local/",
          "to": "/root/.local"
        }
      ],
      "command": [
        "flask",
        "run"
      ],
      "workdir": "/app",
      "ports": [
        5000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]
