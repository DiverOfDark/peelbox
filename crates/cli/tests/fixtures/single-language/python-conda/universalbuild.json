[
  {
    "build": {
      "cache": [
        "/root/.cache/pip/"
      ],
      "commands": [
        "pip install --user --no-cache-dir numpy==1.24 flask==3.0 gunicorn==21.2.0"
      ],
      "env": {},
      "packages": [
        "python-3.11",
        "py3.11-pip",
        "build-base",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Conda",
      "framework": "Flask",
      "language": "Python",
      "project_name": "app",
      "reasoning": "Detected from environment.yml"
    },
    "runtime": {
      "command": [
        "flask",
        "run"
      ],
      "copy": [
        {
          "from": ".",
          "to": "/build"
        },
        {
          "from": "/root/.local/",
          "to": "/root/.local"
        }
      ],
      "env": {
        "FLASK_APP": "/build/app.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/root/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "PYTHONUSERBASE": "/root/.local"
      },
      "health": {
        "endpoint": "/"
      },
      "packages": [
        "python-3.11",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "ports": [
        5000
      ],
      "workdir": "/build"
    },
    "version": "1.0"
  }
]
