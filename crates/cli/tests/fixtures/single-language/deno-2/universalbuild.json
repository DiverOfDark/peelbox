[
    {
        "build": {
            "cache": [
                "/deno-dir"
            ],
            "commands": [
                "deno install",
                "deno task build"
            ],
            "env": {
                "DENO_DIR": "/deno-dir"
            },
            "packages": [
                "deno",
                "ca-certificates"
            ]
        },
        "metadata": {
            "build_system": "Deno",
            "language": "Deno",
            "project_name": "app",
            "reasoning": "Detected from deno.json"
        },
        "runtime": {
            "command": [
                "deno",
                "run",
                "--allow-net",
                "--allow-read",
                "--allow-env",
                "main.ts"
            ],
            "copy": [
                {
                    "from": ".",
                    "to": "/app"
                },
                {
                    "from": "/deno-dir",
                    "to": "/deno-dir"
                }
            ],
            "env": {
                "DENO_DIR": "/deno-dir"
            },
            "packages": [
                "deno",
                "ca-certificates"
            ],
            "ports": [
                8000
            ],
            "workdir": "/app"
        },
        "version": "1.0"
    }
]
