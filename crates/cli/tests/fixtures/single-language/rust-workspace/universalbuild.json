[
  {
    "build": {
      "cache": [
        ".cargo",
        "target"
      ],
      "commands": [
        "cargo build --release --manifest-path app/Cargo.toml --target-dir target"
      ],
      "env": {
        "CARGO_HOME": ".cargo"
      },
      "packages": [
        "rust-1.92",
        "build-base",
        "openssl-dev",
        "pkgconf",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Cargo",
      "framework": "Actix Web",
      "language": "Rust",
      "project_name": "app",
      "reasoning": "Detected from Cargo.toml in app"
    },
    "runtime": {
      "command": [
        "/usr/local/bin/app"
      ],
      "copy": [
        {
          "from": "target/release/app",
          "to": "/usr/local/bin/app"
        }
      ],
      "env": {},
      "health": {
        "endpoint": "/health"
      },
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "ports": [
        8081
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
