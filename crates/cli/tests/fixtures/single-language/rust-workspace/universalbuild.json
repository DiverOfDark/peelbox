[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Rust",
      "build_system": "Cargo",
      "framework": "Actix Web",
      "reasoning": "Detected from Cargo.toml in app"
    },
    "build": {
      "packages": [],
      "env": {
        "CARGO_HOME": "/usr/local/cargo",
        "PATH": "/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "RUSTUP_HOME": "/usr/local/rustup"
      },
      "commands": [
        "cargo build --release --manifest-path app/Cargo.toml --target-dir target"
      ],
      "cache": [
        "/usr/local/cargo",
        "target"
      ],
      "build_image": "docker.io/library/rust:latest"
    },
    "runtime": {
      "packages": [
        "glibc",
        "libssl3",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "target/release/app",
          "to": "/app/app"
        }
      ],
      "command": [
        "/app/app"
      ],
      "workdir": "/app",
      "ports": [
        8081,
        8080
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
