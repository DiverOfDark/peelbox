[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "hello-world",
      "language": "Rust",
      "build_system": "Cargo",
      "framework": "Actix Web",
      "reasoning": "Detected from Cargo.toml"
    },
    "build": {
      "packages": [
        "rust-1.92",
        "build-base",
        "openssl-dev",
        "pkgconf",
        "ca-certificates"
      ],
      "env": {
        "CARGO_HOME": ".cargo"
      },
      "commands": [
        "cargo build --release"
      ],
      "cache": [
        ".cargo",
        "target"
      ]
    },
    "runtime": {
      "packages": [
        "glibc",
        "libssl3",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "target/release/hello-world",
          "to": "/app/hello-world"
        }
      ],
      "command": [
        "/app/hello-world"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
