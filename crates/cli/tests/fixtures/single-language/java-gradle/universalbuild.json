[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Java",
      "build_system": "Gradle",
      "framework": "Spring Boot",
      "reasoning": "Detected from build.gradle"
    },
    "build": {
      "packages": [
        "openjdk-17",
        "gradle-8",
        "ca-certificates"
      ],
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.native=false",
        "GRADLE_USER_HOME": "/root/.gradle",
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk"
      },
      "commands": [
        "gradle assemble -x test --no-daemon --console=plain"
      ],
      "cache": [
        ".gradle",
        "build"
      ]
    },
    "runtime": {
      "packages": [
        "openjdk-17-jre",
        "ca-certificates"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "copy": [
        {
          "from": "build/libs/example-app-1.0.0.jar",
          "to": "/app/app.jar"
        }
      ],
      "command": [
        "java",
        "-jar",
        "/app/app.jar"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
