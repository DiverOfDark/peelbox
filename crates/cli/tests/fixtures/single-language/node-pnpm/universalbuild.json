[
  {
    "build": {
      "cache": [
        ".pnpm-store"
      ],
      "commands": [
        "pnpm install",
        "pnpm build"
      ],
      "env": {},
      "packages": [
        "nodejs-22",
        "pnpm",
        "build-base",
        "python-3.14",
        "npm",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "pnpm",
      "language": "JavaScript",
      "project_name": "example-node-app",
      "reasoning": "Detected from pnpm-lock.yaml"
    },
    "runtime": {
      "command": [
        "node",
        "dist/index.js"
      ],
      "copy": [
        {
          "from": ".",
          "to": "/app"
        }
      ],
      "env": {},
      "health": {
        "endpoint": "/health"
      },
      "packages": [
        "nodejs-22",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "ports": [
        3000
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
