[
  {
    "build": {
      "cache": [
        "build",
        "CMakeCache.txt"
      ],
      "commands": [
        "cmake -B build -DCMAKE_BUILD_TYPE=Release",
        "cmake --build build --config Release"
      ],
      "env": {},
      "packages": [
        "build-base",
        "cmake",
        "gcc",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "CMake",
      "language": "C++",
      "project_name": "app",
      "reasoning": "Detected from CMakeLists.txt in "
    },
    "runtime": {
      "command": [
        "/usr/local/bin/app"
      ],
      "copy": [
        {
          "from": "build/app",
          "to": "/usr/local/bin/app"
        }
      ],
      "env": {},
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "ports": [
        8080
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
