[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "spring-boot-3-app",
      "language": "Java",
      "build_system": "Maven",
      "framework": "Spring Boot",
      "reasoning": "Detected from pom.xml"
    },
    "build": {
      "packages": [
        "openjdk-21",
        "maven-3.9",
        "ca-certificates"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk",
        "MAVEN_OPTS": "-Dmaven.repo.local=/root/.m2/repository"
      },
      "commands": [
        "mvn package -DskipTests",
        "mvn dependency:copy-dependencies -DoutputDirectory=target/lib"
      ],
      "cache": [
        "/root/.m2/repository"
      ]
    },
    "runtime": {
      "packages": [
        "openjdk-21-jre",
        "ca-certificates"
      ],
      "env": {
        "CLASSPATH": "/app/*:/app/lib/*",
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk",
        "PATH": "/usr/lib/jvm/java-21-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "copy": [
        {
          "from": "target/*.jar",
          "to": "/app/"
        },
        {
          "from": "target/lib/",
          "to": "/app/lib"
        }
      ],
      "command": [
        "java",
        "-jar",
        "/app/spring-boot-3-app-1.0.0.jar"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ],
      "health": {
        "endpoint": "/actuator/health"
      }
    }
  }
]
