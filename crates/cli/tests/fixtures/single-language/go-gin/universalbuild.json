[
  {
    "build": {
      "cache": [
        ".cache/go-build",
        ".cache/go-mod"
      ],
      "commands": [
        "go mod download",
        "go build -o go-gin-app ."
      ],
      "env": {
        "CGO_ENABLED": "0",
        "GOCACHE": "/build/.cache/go-build",
        "GOMODCACHE": "/build/.cache/go-mod",
        "GOSUMDB": "off"
      },
      "packages": [
        "go-1.21",
        "git",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "go mod",
      "framework": "Gin",
      "language": "Go",
      "project_name": "go-gin-app",
      "reasoning": "Detected from go.mod"
    },
    "runtime": {
      "command": [
        "/app/go-gin-app"
      ],
      "copy": [
        {
          "from": "go-gin-app",
          "to": "/app/go-gin-app"
        }
      ],
      "env": {},
      "health": {
        "endpoint": "/health"
      },
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "ports": [
        8080
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
