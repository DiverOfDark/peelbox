[
  {
    "build": {
      "cache": [
        ".lein",
        ".m2",
        "target"
      ],
      "commands": [
        "curl -fsSL https://raw.githubusercontent.com/technomancy/leiningen/stable/bin/lein -o /usr/local/bin/lein && chmod +x /usr/local/bin/lein && lein version",
        "lein uberjar"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "LEIN_HOME": "/root/.lein"
      },
      "packages": [
        "openjdk-17",
        "bash",
        "curl",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Leiningen",
      "framework": "Ring",
      "language": "Clojure",
      "project_name": "my-app",
      "reasoning": "Detected from project.clj"
    },
    "runtime": {
      "command": [
        "java",
        "-jar",
        "/app/my-app-standalone.jar"
      ],
      "copy": [
        {
          "from": "target/uberjar/my-app-standalone.jar",
          "to": "/app/my-app-standalone.jar"
        }
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "health": {
        "endpoint": "/health"
      },
      "packages": [
        "openjdk-17-jre",
        "ca-certificates"
      ],
      "ports": [
        3000
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
