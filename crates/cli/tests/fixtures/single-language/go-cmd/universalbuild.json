[
    {
        "build": {
            "cache": [
                ".cache/go-build",
                ".cache/go-mod"
            ],
            "commands": [
                "go mod download",
                "go build -o go-cmd-app ."
            ],
            "env": {
                "CGO_ENABLED": "0",
                "GOCACHE": "/build/.cache/go-build",
                "GOMODCACHE": "/build/.cache/go-mod",
                "GOSUMDB": "off"
            },
            "packages": [
                "go-1.22",
                "ca-certificates"
            ]
        },
        "metadata": {
            "build_system": "go mod",
            "language": "Go",
            "project_name": "go-cmd-app",
            "reasoning": "Detected from go.mod"
        },
        "runtime": {
            "command": [
                "/app/go-cmd-app"
            ],
            "copy": [
                {
                    "from": "go-cmd-app",
                    "to": "/app/go-cmd-app"
                }
            ],
            "env": {},
            "health": {
                "endpoint": "/health"
            },
            "packages": [
                "glibc",
                "ca-certificates"
            ],
            "ports": [
                8080
            ],
            "workdir": "/app"
        },
        "version": "1.0"
    }
]
