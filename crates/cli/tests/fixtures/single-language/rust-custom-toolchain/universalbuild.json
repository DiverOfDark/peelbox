[
  {
    "build": {
      "cache": [
        ".cargo",
        "target"
      ],
      "commands": [
        "cargo build --release"
      ],
      "env": {
        "CARGO_HOME": ".cargo"
      },
      "packages": [
        "rust-1.75",
        "build-base",
        "openssl-dev",
        "pkgconf",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Cargo",
      "language": "Rust",
      "project_name": "rust-toolchain-demo",
      "reasoning": "Detected from Cargo.toml"
    },
    "runtime": {
      "command": [
        "/app/rust-toolchain-demo"
      ],
      "copy": [
        {
          "from": "target/release/rust-toolchain-demo",
          "to": "/app/rust-toolchain-demo"
        }
      ],
      "env": {},
      "packages": [
        "glibc",
        "libssl3",
        "ca-certificates"
      ],
      "ports": [],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
