[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "app",
      "language": "Python",
      "build_system": "Pipenv",
      "framework": "Flask",
      "reasoning": "Detected from Pipfile"
    },
    "build": {
      "packages": [
        "python-3.11",
        "py3.11-pip",
        "build-base",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "pip install --user pipenv",
        "/root/.local/bin/pipenv lock --python $(which python3) && /root/.local/bin/pipenv requirements > /tmp/requirements.txt && pip install --user --no-cache-dir -r /tmp/requirements.txt"
      ],
      "cache": [
        "/root/.cache/pip/"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.11",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "FLASK_APP": "/build/app.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/root/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "PYTHONUSERBASE": "/root/.local"
      },
      "copy": [
        {
          "from": ".",
          "to": "/build"
        },
        {
          "from": "/root/.local/",
          "to": "/root/.local"
        }
      ],
      "command": [
        "flask",
        "run"
      ],
      "workdir": "/build",
      "ports": [
        5000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  }
]
