[
  {
    "build": {
      "cache": [
        ".cache/bazel"
      ],
      "commands": [
        "bazel build //..."
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk"
      },
      "packages": [
        "build-base",
        "bazel-7",
        "openjdk-21-default-jdk",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Bazel",
      "language": "C++",
      "project_name": "hello",
      "reasoning": "Detected from BUILD"
    },
    "runtime": {
      "command": [
        "/app/hello"
      ],
      "copy": [
        {
          "from": "bazel-bin/hello",
          "to": "/app/hello"
        }
      ],
      "env": {},
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "ports": [
        8080
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
