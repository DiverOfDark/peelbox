[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "@bun-monorepo/api",
      "language": "JavaScript",
      "build_system": "Bun",
      "framework": "Express",
      "reasoning": "Detected from package.json in packages/api"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "bun",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "bun install",
        "cd packages/api && bun run build"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "bun",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "bun",
        "start"
      ],
      "workdir": "/app/packages/api",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
