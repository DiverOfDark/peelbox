[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "@moon-workspace/api",
      "language": "JavaScript",
      "build_system": "npm",
      "framework": "Express",
      "reasoning": "Detected from package.json in apps/api"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "npm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "npm install",
        "cd apps/api && npm run build"
      ],
      "cache": [
        ".npm"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "npm",
        "start"
      ],
      "workdir": "/app/apps/api",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
