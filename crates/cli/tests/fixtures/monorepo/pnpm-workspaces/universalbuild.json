[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "@monorepo/web",
      "language": "JavaScript",
      "build_system": "pnpm",
      "framework": "Express",
      "reasoning": "Detected from package.json in apps/web"
    },
    "build": {
      "packages": [],
      "env": {},
      "commands": [
        "pnpm install",
        "cd apps/web && pnpm run build"
      ],
      "cache": [
        ".npm"
      ],
      "build_image": "docker.io/library/node:lts"
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "pnpm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "pnpm",
        "start"
      ],
      "workdir": "/app/apps/web",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
