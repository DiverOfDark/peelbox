[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "api",
      "language": "Go",
      "build_system": "go mod",
      "reasoning": "Detected from go.mod in cmd/api"
    },
    "build": {
      "packages": [],
      "env": {
        "CGO_ENABLED": "0",
        "GOCACHE": "/app/.cache/go-build",
        "GOMODCACHE": "/app/.cache/go-mod",
        "GOSUMDB": "off",
        "PATH": "/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "mkdir -p bin",
        "go build -o bin/api ./cmd/api"
      ],
      "cache": [
        ".cache/go-build",
        ".cache/go-mod"
      ],
      "build_image": "docker.io/library/golang:1.21"
    },
    "runtime": {
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "bin/api",
          "to": "/app/api"
        }
      ],
      "command": [
        "/app/api"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  }
]
