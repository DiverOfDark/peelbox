[
  {
    "build": {
      "cache": [
        ".cache/go-build",
        ".cache/go-mod"
      ],
      "commands": [
        "go mod download",
        "go build -o api ."
      ],
      "env": {
        "CGO_ENABLED": "0",
        "GOCACHE": "/build/.cache/go-build",
        "GOMODCACHE": "/build/.cache/go-mod",
        "GOSUMDB": "off"
      },
      "packages": [
        "go-1.21",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "go mod",
      "language": "Go",
      "project_name": "api",
      "reasoning": "Detected from go.mod in cmd/api"
    },
    "runtime": {
      "command": [
        "/app/api"
      ],
      "copy": [
        {
          "from": "api",
          "to": "/app/api"
        }
      ],
      "env": {},
      "packages": [
        "glibc",
        "ca-certificates"
      ],
      "ports": [
        8080
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  },
