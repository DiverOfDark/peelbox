[
  {
    "build": {
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/uv/"
      ],
      "commands": [
        "pip install --user uv",
        "/root/.local/bin/uv sync --frozen --no-dev --package api"
      ],
      "env": {
        "UV_CACHE_DIR": "/root/.cache/uv"
      },
      "packages": [
        "python-3.12",
        "py3.12-pip",
        "build-base",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "uv",
      "framework": "Flask",
      "language": "Python",
      "project_name": "api",
      "reasoning": "Detected from pyproject.toml in packages/api"
    },
    "runtime": {
      "command": [
        "flask",
        "run"
      ],
      "copy": [
        {
          "from": ".",
          "to": "/build"
        }
      ],
      "env": {
        "FLASK_APP": "/app/packages/api/src/api/app.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/app/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/app/.venv"
      },
      "health": {
        "endpoint": "/"
      },
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "ports": [
        5000
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  },
  {
    "build": {
