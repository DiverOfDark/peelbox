[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "api",
      "language": "Python",
      "build_system": "uv",
      "framework": "Flask",
      "reasoning": "Detected from pyproject.toml in packages/api"
    },
    "build": {
      "packages": [
        "python-3.12",
        "py3.12-pip",
        "build-base",
        "ca-certificates"
      ],
      "env": {
        "UV_CACHE_DIR": "/root/.cache/uv"
      },
      "commands": [
        "pip install --user uv",
        "/root/.local/bin/uv sync --frozen --no-dev --package api"
      ],
      "cache": [
        "/root/.cache/pip/",
        "/root/.cache/uv/"
      ]
    },
    "runtime": {
      "packages": [
        "python-3.12",
        "libgcc",
        "libstdc++",
        "ca-certificates"
      ],
      "env": {
        "FLASK_APP": "/build/packages/api/src/api/app.py",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "5000",
        "PATH": "/build/.venv/bin:/usr/local/bin:/usr/bin:/bin",
        "VIRTUAL_ENV": "/build/.venv"
      },
      "copy": [
        {
          "from": ".",
          "to": "/build"
        }
      ],
      "command": [
        "flask",
        "run"
      ],
      "workdir": "/build",
      "ports": [
        5000
      ],
      "health": {
        "endpoint": "/"
      }
    }
  },
