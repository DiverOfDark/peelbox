[
  {
    "build": {
      "cache": [
        ".gradle",
        "build"
      ],
      "commands": [
        "gradle :app:assemble -x test --no-daemon --console=plain"
      ],
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.native=false",
        "GRADLE_USER_HOME": "/root/.gradle",
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk"
      },
      "packages": [
        "openjdk-21",
        "gradle-8",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Gradle",
      "language": "Java",
      "project_name": "app",
      "reasoning": "Detected from build.gradle in app"
    },
    "runtime": {
      "command": [
        "java",
        "-jar",
        "/app/app.jar"
      ],
      "copy": [
        {
          "from": "app/build/libs/*.jar",
          "to": "/app/app.jar"
        }
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk",
        "PATH": "/usr/lib/jvm/java-21-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "packages": [
        "openjdk-21-jre",
        "ca-certificates"
      ],
      "ports": [
        8080
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
