[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "@monorepo/web",
      "language": "JavaScript",
      "build_system": "Yarn",
      "framework": "Express",
      "reasoning": "Detected from package.json in apps/web"
    },
    "build": {
      "packages": [
        "nodejs-25",
        "yarn",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "yarn install --network-timeout 100000 --network-concurrency 1",
        "cd apps/web && yarn run build"
      ],
      "cache": [
        ".yarn-cache"
      ]
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates",
        "yarn"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "yarn",
        "start"
      ],
      "workdir": "/app/apps/web",
      "ports": [
        3000
      ],
      "health": {
        "endpoint": "/health"
      }
    }
  }
]
