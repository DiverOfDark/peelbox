[
  {
    "build": {
      "cache": [
        "/root/.m2/repository"
      ],
      "commands": [
        "mvn -pl api-service -am install -DskipTests",
        "mvn -pl api-service dependency:copy-dependencies -DoutputDirectory=target/lib"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "MAVEN_OPTS": "-Dmaven.repo.local=/root/.m2/repository"
      },
      "packages": [
        "openjdk-17",
        "maven-3.9",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Maven",
      "framework": "Spring Boot",
      "language": "Java",
      "project_name": "api-service",
      "reasoning": "Detected from pom.xml in api-service"
    },
    "runtime": {
      "command": [
        "java",
        "-jar",
        "/app/api-service-1.0.0.jar"
      ],
      "copy": [
        {
          "from": "api-service/target/*.jar",
          "to": "/app/"
        },
        {
          "from": "api-service/target/lib/",
          "to": "/app/lib"
        }
      ],
      "env": {
        "CLASSPATH": "/app/*:/app/lib/*",
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "health": {
        "endpoint": "/actuator/health"
      },
      "packages": [
        "openjdk-17-jre",
        "ca-certificates"
      ],
      "ports": [
        8080
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  },
