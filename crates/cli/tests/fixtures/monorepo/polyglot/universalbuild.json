[
  {
    "build": {
      "cache": [
        "/root/.m2/repository"
      ],
      "commands": [
        "mvn -f backend/pom.xml package -DskipTests",
        "mvn -f backend/pom.xml dependency:copy-dependencies -DoutputDirectory=target/lib; mkdir -p backend/target/lib"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "MAVEN_OPTS": "-Dmaven.repo.local=/root/.m2/repository"
      },
      "packages": [
        "openjdk-17",
        "maven-3.9",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Maven",
      "language": "Java",
      "project_name": "backend",
      "reasoning": "Detected from pom.xml in backend"
    },
    "runtime": {
      "command": [
        "java",
        "-cp",
        "/app/*.jar",
        "com.example.Backend"
      ],
      "copy": [
        {
          "from": "backend/target/*.jar",
          "to": "/app/"
        },
        {
          "from": "backend/target/lib/",
          "to": "/app/lib"
        }
      ],
      "env": {
        "CLASSPATH": "/app/*:/app/lib/*",
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "packages": [
        "openjdk-17-jre",
        "ca-certificates"
      ],
      "ports": [
        8080
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  },
  {
    "build": {
      "cache": [
        ".cargo",
        "target"
      ],
      "commands": [
        "cargo build --release --manifest-path cli/Cargo.toml --target-dir target"
      ],
      "env": {
        "CARGO_HOME": ".cargo"
      },
      "packages": [
        "rust-1.92",
        "build-base",
        "openssl-dev",
        "pkgconf",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "Cargo",
      "language": "Rust",
      "project_name": "admin-service",
      "reasoning": "Detected from Cargo.toml in cli"
    },
    "runtime": {
      "command": [
        "/app/admin-service"
      ],
      "copy": [
        {
          "from": "target/release/admin-service",
          "to": "/app/admin-service"
        }
      ],
      "env": {},
      "packages": [
        "glibc",
        "libssl3",
        "ca-certificates"
      ],
      "ports": [
        8082
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  },
  {
    "build": {
      "cache": [
        ".npm"
      ],
      "commands": [
        "cd frontend && npm ci",
        "cd frontend && npm run build"
      ],
      "env": {},
      "packages": [
        "nodejs-25",
        "npm",
        "ca-certificates"
      ]
    },
    "metadata": {
      "build_system": "npm",
      "language": "JavaScript",
      "project_name": "frontend",
      "reasoning": "Detected from package.json in frontend"
    },
    "runtime": {
      "command": [
        "npm",
        "start"
      ],
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "env": {},
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "ports": [
        3000
      ],
      "workdir": "/app"
    },
    "version": "1.0"
  }
]
