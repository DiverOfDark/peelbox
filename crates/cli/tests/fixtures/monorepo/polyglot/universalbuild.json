[
  {
    "version": "1.0",
    "metadata": {
      "project_name": "backend",
      "language": "Java",
      "build_system": "Maven",
      "reasoning": "Detected from pom.xml in backend"
    },
    "build": {
      "packages": [
        "openjdk-17",
        "maven",
        "ca-certificates"
      ],
      "env": {
        "MAVEN_OPTS": "-Dmaven.repo.local=/root/.m2/repository",
        "JAVA_HOME": "/opt/java/openjdk",
        "PATH": "/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "mvn -f backend/pom.xml package -DskipTests",
        "mvn -f backend/pom.xml dependency:copy-dependencies -DoutputDirectory=target/lib && mkdir -p backend/target/lib"
      ],
      "cache": [
        "/root/.m2/repository"
      ],
      "build_image": "docker.io/library/maven:3-eclipse-temurin-17"
    },
    "runtime": {
      "packages": [
        "openjdk-17-jre",
        "ca-certificates"
      ],
      "env": {
        "CLASSPATH": "/app/*:/app/lib/*",
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "PORT": "8080"
      },
      "copy": [
        {
          "from": "backend/target/*.jar",
          "to": "/app/"
        },
        {
          "from": "backend/target/lib/",
          "to": "/app/lib"
        }
      ],
      "command": [
        "java",
        "-cp",
        "/app/*:/app/lib/*",
        "com.example.Backend"
      ],
      "workdir": "/app",
      "ports": [
        8080
      ]
    }
  },
  {
    "version": "1.0",
    "metadata": {
      "project_name": "admin-service",
      "language": "Rust",
      "build_system": "Cargo",
      "reasoning": "Detected from Cargo.toml in cli"
    },
    "build": {
      "packages": [],
      "env": {
        "CARGO_HOME": "/usr/local/cargo",
        "RUSTUP_HOME": "/usr/local/rustup",
        "PATH": "/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "commands": [
        "cd cli && apt-get update && apt-get install -y --no-install-recommends build-essential libssl-dev pkg-config ca-certificates && rm -rf /var/lib/apt/lists/*",
        "cargo build --release --manifest-path cli/Cargo.toml --target-dir target"
      ],
      "cache": [
        "/usr/local/cargo",
        "target"
      ],
      "build_image": "docker.io/library/rust:latest"
    },
    "runtime": {
      "packages": [
        "glibc",
        "libssl3",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": "target/release/admin-service",
          "to": "/app/admin-service"
        }
      ],
      "command": [
        "/app/admin-service"
      ],
      "workdir": "/app",
      "ports": [
        8082
      ]
    }
  },
  {
    "version": "1.0",
    "metadata": {
      "project_name": "frontend",
      "language": "JavaScript",
      "build_system": "npm",
      "reasoning": "Detected from package.json in frontend"
    },
    "build": {
      "packages": [
        "nodejs",
        "npm",
        "ca-certificates"
      ],
      "env": {},
      "commands": [
        "npm install -g node-gyp",
        "ln -sf /usr/local/lib/node_modules/node-gyp /usr/lib/node_modules/npm/node_modules/node-gyp",
        "cd frontend && npm ci",
        "cd frontend && npm run build"
      ],
      "cache": [
        ".npm"
      ],
      "build_image": "docker.io/library/node:lts"
    },
    "runtime": {
      "packages": [
        "nodejs-25",
        "npm",
        "busybox",
        "dumb-init",
        "ca-certificates"
      ],
      "env": {},
      "copy": [
        {
          "from": ".",
          "to": "/app/"
        }
      ],
      "command": [
        "npm",
        "start"
      ],
      "workdir": "/app/frontend",
      "ports": [
        3000
      ]
    }
  }
]
